#!/usr/bin/env python3
"""Time Machine Watchdog: read-only backup freshness check."""
import argparse
import datetime as dt
import json
import math
import os
import re
import subprocess
import sys

VERSION = "0.3.1"


def tmutil(*args):
    binary = os.environ.get("TMWATCH_TMUTIL", "tmutil")
    try:
        return subprocess.run([binary, *args], text=True, capture_output=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess([binary, *args], 127, "", str(exc))


def field(text, name):
    match = re.search(rf"^\s*{re.escape(name)}\s*:\s*(.+?)\s*$", text, re.MULTILINE)
    return match.group(1) if match else None


def backup_time(text):
    matches = re.findall(r"(20\d{2})-(\d{2})-(\d{2})[-_](\d{2})(\d{2})(\d{2})", text)
    if not matches:
        return None
    values = []
    for item in matches:
        try:
            wall = dt.datetime(*map(int, item))
        except ValueError:
            return None
        # Resolve the offset at the backup date, not at the current date.
        first = wall.replace(fold=0).astimezone()
        second = wall.replace(fold=1).astimezone()
        if first != second or first.replace(tzinfo=None) != wall:
            raise ValueError("Backup local time is ambiguous or nonexistent at a clock transition.")
        values.append(first)
    return max(values)


def inspect(now, threshold_hours):
    destination = tmutil("destinationinfo")
    latest = tmutil("latestbackup")
    status = tmutil("status")
    destination_text = destination.stdout if destination.returncode == 0 else ""
    latest_text = latest.stdout if latest.returncode == 0 else ""
    destination_name = field(destination_text, "Name")
    destination_kind = field(destination_text, "Kind")
    time_error = None
    try:
        stamp = backup_time(latest_text)
    except ValueError as exc:
        stamp, time_error = None, str(exc)
    age_hours = round((now - stamp).total_seconds() / 3600, 1) if stamp else None
    running_match = re.search(r"^\s*Running\s*[=:]\s*([01])\s*;?\s*$", status.stdout, re.MULTILINE)
    running = bool(int(running_match[1])) if status.returncode == 0 and running_match else None

    if destination.returncode != 0 or latest.returncode != 0:
        state, detail = "UNKNOWN", "A required tmutil probe failed; backup health cannot be determined."
    elif time_error:
        state, detail = "UNKNOWN", time_error
    elif not (destination_name or destination_kind):
        state, detail = "NO_DESTINATION", "No configured Time Machine destination was reported."
    elif stamp is None:
        state, detail = "NO_BACKUP", "No dated successful backup was reported."
    elif stamp > now:
        state, detail = "UNKNOWN", "Backup timestamp is in the future; check clock and timezone."
    elif (now - stamp).total_seconds() > threshold_hours * 3600:
        state, detail = "STALE", f"Latest reported backup is {age_hours:.1f} hours old."
    else:
        state, detail = "OK", f"Latest reported backup is {age_hours:.1f} hours old."

    return {
        "status": state,
        "detail": detail,
        "threshold_hours": threshold_hours,
        "age_hours": age_hours,
        "latest_backup_utc": stamp.astimezone(dt.timezone.utc).isoformat().replace("+00:00", "Z") if stamp else None,
        "destination_name": destination_name,
        "destination_kind": destination_kind,
        "backup_running": running,
        "read_only": True,
    }


def render(report):
    print(f"{report['status']}: {report['detail']}")
    print(f"Destination: {report['destination_name'] or 'unavailable'} ({report['destination_kind'] or 'unknown kind'})")
    running = {True: "yes", False: "no", None: "unknown"}[report['backup_running']]
    print(f"Backup running now: {running}")
    print("Safety: read-only; no backup, destination, schedule, or notification was changed.")


def redact(report):
    """Return a share-safer copy without the destination label."""
    safe = dict(report)
    if safe["destination_name"]:
        safe["destination_name"] = "[redacted]"
    safe["redacted"] = True
    return safe


def main():
    parser = argparse.ArgumentParser(
        description="Check Time Machine destination and latest-backup freshness without changing anything."
    )
    parser.add_argument("--threshold-hours", type=float, default=48.0, metavar="HOURS")
    parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    parser.add_argument(
        "--redact",
        action="store_true",
        help="replace the destination name with [redacted] before printing",
    )
    parser.add_argument("--version", action="version", version=f"Time Machine Watchdog {VERSION}")
    args = parser.parse_args()
    if not math.isfinite(args.threshold_hours) or args.threshold_hours <= 0:
        parser.error("--threshold-hours must be finite and greater than zero")
    report = inspect(dt.datetime.now().astimezone(), args.threshold_hours)
    if args.redact:
        report = redact(report)
    if args.json:
        json.dump(report, sys.stdout, indent=2)
        print()
    else:
        render(report)
    return 0 if report["status"] == "OK" else 2


if __name__ == "__main__":
    raise SystemExit(main())
